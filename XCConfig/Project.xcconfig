DEVELOPMENT_TEAM = 66CMG54L8U

// Release signing for the APP TARGET only (its Release config reads these).
// `make archive` and release.yml override these variables, never
// CODE_SIGN_ENTITLEMENTS / PROVISIONING_PROFILE_SPECIFIER directly: a
// command-line build setting applies to every target, including the Swift
// package targets, which then look for the entitlements file relative to
// their own checkout and fail the archive.
PUNCTUAL_ENTITLEMENTS = Punctual/Punctual.entitlements
PUNCTUAL_PROFILE_SPECIFIER =

// Sparkle update feed. The latest GitHub release always serves its own
// appcast.xml at this address. A local end-to-end update test overrides it at
// build time (PUNCTUAL_UPDATE_FEED_URL=http://127.0.0.1:...). The `/$()/` is
// how an xcconfig spells `//`, which otherwise starts a comment.
PUNCTUAL_UPDATE_FEED_URL = https:/$()/github.com/Chykalophia/Punctual/releases/latest/download/appcast.xml
// GOOGLE_CLIENT_ID is the current name and accepts either the full client id or
// just the part before `.apps.googleusercontent.com`. GOOGLE_CLIENT_NUMBER is the
// former name, still read as a fallback so an existing GoogleSecrets.xcconfig
// keeps working.
GOOGLE_CLIENT_ID = REPLACE_BY_YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_NUMBER = REPLACE_BY_YOUR_GOOGLE_CLIENT_NUMBER
GOOGLE_CLIENT_SECRET = REPLACE_BY_YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_AUTH_KEYCHAIN_NAME = REPLACE_BY_YOUR_GOOGLE_AUTH_KEYCHAIN_NAME
SWIFT_STRICT_CONCURRENCY = complete
#include? "DevTeamOverride.xcconfig"
// Optional local Google OAuth credentials (git-ignored). Copy
// GoogleSecrets.xcconfig.example to GoogleSecrets.xcconfig and fill it in to
// use your own Google Calendar in a local build. Included last so its values
// override the REPLACE_BY_YOUR_* placeholders above.
#include? "GoogleSecrets.xcconfig"
