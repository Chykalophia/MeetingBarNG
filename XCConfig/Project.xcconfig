DEVELOPMENT_TEAM = 66CMG54L8U
// GOOGLE_CLIENT_ID is the current name and accepts either the full client id or
// just the part before `.apps.googleusercontent.com`. GOOGLE_CLIENT_NUMBER is the
// former name, still read as a fallback so an existing GoogleSecrets.xcconfig
// keeps working.
GOOGLE_CLIENT_ID = REPLACE_BY_YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_NUMBER = REPLACE_BY_YOUR_GOOGLE_CLIENT_NUMBER
GOOGLE_CLIENT_SECRET = REPLACE_BY_YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_AUTH_KEYCHAIN_NAME = REPLACE_BY_YOUR_GOOGLE_AUTH_KEYCHAIN_NAME
SWIFT_STRICT_CONCURRENCY = complete
#include? "DevTeamOverride.xcconfig"
// Optional local Google OAuth credentials (git-ignored). Copy
// GoogleSecrets.xcconfig.example to GoogleSecrets.xcconfig and fill it in to
// use your own Google Calendar in a local build. Included last so its values
// override the REPLACE_BY_YOUR_* placeholders above.
#include? "GoogleSecrets.xcconfig"
